load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    visibility = ["//visibility:public"],
    name = "wnav_core",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["schemars"],
    deps = [
        "@crates//:serde",
        "@crates//:toml",
        "@crates//:toml_edit",
        "@crates//:dirs",
        "@crates//:schemars",
    ],
)

rust_test(
    name = "wnav_core_test",
    crate = ":wnav_core",
    edition = "2021",
    deps = [
        "@crates//:serde",
        "@crates//:toml",
        "@crates//:toml_edit",
        "@crates//:dirs",
        "@crates//:schemars",
        "@crates//:serde_json",
    ],
)
