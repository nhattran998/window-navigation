module(
    name = "grid",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.Bazel.toml"],
)
# gpui-pre gates inspector derives behind `any(feature = "inspector",
# debug_assertions)`. Cargo dev builds pass via debug_assertions; Bazel opt
# builds need the feature enabled explicitly.
crate.annotation(
    crate = "gpui-pre",
    crate_features = ["inspector"],
)
crate.annotation(
    crate = "gpui-pre-macros",
    crate_features = ["inspector"],
)
use_repo(crate, "crates")
